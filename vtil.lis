                                     0000   553 ;******************************************************************************
                                     0000   554 ;
                                     0000   555 ; Kernel Built-Ins -- Original vocabulary of words.  All other vocabularies
                                     0000   556 ;	link into this one, except the compiler (compiletime word) vocabulary.
                                     0000   557 ;
                                     0000   558 ;******************************************************************************
                                     0000   559 _kernel_begin:
                                     0000   560 
                                     0000   561 
                                     0000   562 ;+++t
                                     0000   563 ;k> ! (store) -- ( n a -- ) store longword `n' at `a'.
                                     0000   564 ;---
                                     0000   565 	header	i_store,<!>
                 00 BB   04 AB   D0  0006   566 	movl	4(r11),@(r11)		; store item at what's pointed to by
                                     000B   567 					; top of stack
                       5B   08   C0  000B   568 	addl2	#8,r11			; pop arguments
                                 05  000E   569 	rsb				; end of !
                                     000F   570 
                                     000F   571 
                                     000F   572 ;+++
                                     000F   573 ;k> # -- ( n1 -- n2 ) generate next output character in number conversion.
                                     000F   574 ;	used between { <# } and { #> }.
                                     000F   575 ;---
                                     000F   576 	header	i_sharp,<#>
                       7B   6B   D0  0015   577 	movl	(r11),-(r11)	;~~~ make n1 an unsigned quadword: ( n1 n1 )
                         04 AB   D4  0018   578 	clrl	4(r11)		;~~~ ( n1 0 ), which is n1 zero-extended
 6B   04 AB   6B   00001D36'EF   7B  001B   579 	ediv	v_radix,(r11),4(r11),(r11) ;~~~ ( n2 digit ), unsigned
                   000012BA'EF   16  0025   580 	jsb	tochar		; make it appropriate ascii char
                          0AE2   31  002B   581 	brw	hold		; put in output string; end of #~~~ was jsb i_div_mod for the digit, which went wrong for -2147483648
                                     002E   582 
                                     002E   583 
                                     002E   584 ;+++
                                     002E   585 ;k> #> -- ( n1 -- a n2 ) End numeric output.  Leaves length and address of
                                     002E   586 ;	numeric text on stack for { write }.
                                     002E   587 ;---
                                     002E   588 	header	i_sharp_greater,^\#>\
              6B   00001D3A'EF   D0  0035   589 	movl	v_hld,(r11)		; drop number, put address of output
                                     003C   590 					; on stack
         50   00000100 8F   59   C1  003C   591 	addl3	r9,#c_pad_moat,r0	; get address of pad
         7B   50   00001D3A'EF   C3  0044   592 	subl3	v_hld,r0,-(r11)		; put count on stack
                                     004C   593 					; count = pad - hld
                                 05  004C   594 	rsb				; end of #>
                                     004D   595 
                                     004D   596 
                                     004D   597 ;+++
                                     004D   598 ;k> #s -- ( n1 -- n2 ) Convert all digits of `n1' to output string.  Leaves 0.
                                     004D   599 ;	Used between { <# } and { #> }.
                                     004D   600 ;---
                                     004D   601 	header	i_sharp_s,<#s>
                         BE AF   16  0054   602 	jsb	i_sharp			; output at least one character
                            6B   D5  0057   603 	tstl	(r11)			; is top not = 0?
                            F9   12  0059   604 	bneq	i_sharp_s		; yes, do it again
                                 05  005B   605 	rsb				; no, exit
                                     005C   606 					; end of #s
                                     005C   607 
