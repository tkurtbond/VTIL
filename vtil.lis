                                     153A  2874 ;*******************************************************************************
                                     153A  2875 ;
                                     153A  2876 ; Compiler Built-ins -- a new word is unlinked from the current vocabulary
                                     153A  2877 ;	and linked into the compiler vocabulary by the word { compiletime }.
                                     153A  2878 ;	Compiler (or compiletime) words are only searched for during the
                                     153A  2879 ;	definition of new words, which prevents them from mucking about with
                                     153A  2880 ;	the stacks and the dictionary when we are interpreting the user's
                                     153A  2881 ;	commands.
                                     153A  2882 ;
                                     153A  2883 ;*******************************************************************************
                                     153A  2884 compiler_begin:
                                     153A  2885 
                                     153A  2886 
                                     153A  2887 ;+++
                                     153A  2888 ;c> (variable) -- ( -- ) compiles the code body of a word that pushes the
                                     153A  2889 ;	address of its parameter field on the stack.  Must be the last word
                                     153A  2890 ;	in the word...
                                     153A  2891 ;---
                                     153A  2892 ;??? This concept is fuzzy.  Work on it.
                                     153A  2893      header	  i_variable,<(variable)>,vl_compiler
                    89   9E 8F   90  1549  2894      movb	  #op_movab,(r9)+	; `movab'
                    89   AF 8F   90  154D  2895      movb	  #adm_b_rel,(r9)+	; byte relative
                       89   02   90  1551  2896      movb	  #2,(r9)+		; (pc+2)
                    89   7B 8F   90  1554  2897      movb	  #adm_adec_r11,(r9)+	; -(r11)
                       89   05   90  1558  2898      movb	  #op_rsb,(r9)+		; `rsb'
                                 05  155B  2899      rsb				; end of (variable)
                                     155C  2900 
                                     155C  2901 
                                     155C  2902 ;+++
                                     155C  2903 ;c> +loop -- ( n -- ) where n is an increment.  Ends { do ... +loop }.  Adds top
                                     155C  2904 ;	of stack to loop index and branches to { do } if ((index >= 0) and
                                     155C  2905 ;	(index < limit)), or if ((index < 0) and (index > limit)).~~~ WTF: and should be or???
                                     155C  2906 ;	In other words, { +loop } with a positive argument is like Pascal's
                                     155C  2907 ;	{ for index := start to finish do ... } and with a negative argument
                                     155C  2908 ;	it is like { for index := start downto finish do }.
                                     155C  2909 ;---
                                     155C  2910 	header	i_plus_loop,<+loop>,vl_compiler
                    89   F1 8F   90  1566  2911 	movb	#op_acbl,(r9)+		; `acbl'
                    89   AA 8F   90  156A  2912 	movb	#adm_b_dis_r10,(r9)+	; b^(r10)
                       89   04   90  156E  2913 	movb	#4,(r9)+		; 4 byte displacement for previous adm
