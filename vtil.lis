                            6B   D5  12DA  2657 	tstl	(r11)			; n < 0?
                            12   19  12DC  2658 	blss	100$			; yes, exit
                       23   6B   D1  12DE  2659 	cmpl	(r11),#35		; n > 35
                            0D   14  12E1  2660 	bgtr	100$			; yes, exit
