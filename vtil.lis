                                     0352  1008 ;+++t
                                     0352  1009 ;k> ?search -- ( -- a ? f )  search context vocabulary for most recent token,
                                     0352  1010 ;	return false if not found, or ( addr true ) if found.  If compiling,
                                     0352  1011 ;	search compiler vocab if not found in context and set { state }
                                     0352  1012 ;	true.  Compare byte-counted string at eodp to find.
                                     0352  1013 ;---
                                     0352  1014 	header	q_search,<?search>
                                     035E  1015 ;??? this next perhaps should have been
                                     035E  1016 ;	movl	@v_context,(r11)
                                     035E  1017 ;	tstb	v_mode
                                     035E  1018 ;	beql	5$
                                     035E  1019 ;	movl	@(r11),(r11)
                                     035E  1020 ;5$:
                                     035E  1021 ; which would (during compilation of new words)
                                     035E  1022 ; start the search at the word before the one currently being compiled;
                                     035E  1023 ; this would allow use of older definition of word `x' in new definition
                                     035E  1024 ; of word `x'.	However, as it stands it allows easy recursion.
                                     035E  1025 ;??? changed to eliminate recursion by default, as that is probably more
                                     035E  1026 ; useful, since RECURSE is a simple way to get recursion.
                                     035E  1027 ;??? The problem with this is that if you switch vocabularies while defining
                                     035E  1028 ; a word, the new vocab (which you want to search from the first) also is
                                     035E  1029 ; searched from the second word.  Perhaps I should set the smudge bit (gasp!
                                     035E  1030 ; Horrors!).
                                     035E  1031 ; get pointer to pointer to start of vocab
              7B   00001D1F'FF   D0  035E  1032 	movl @v_context,-(r11)		; get address of current word
                                     0365  1033 ;??? took out to test smudge bit
                                     0365  1034 ;	tstb  v_mode			; Are we compiling?
                                     0365  1035 ;	beql  5$			; no, go on.
                                     0365  1036 ; yes, so skip address of word we are defining, so we can use
                                     0365  1037 ; previous definitions of this word.
                                     0365  1038 ;	movl	@(r11),(r11)		; get address of previous word
                                     0365  1039 5$:
                   00000F83'EF   16  0365  1040 	jsb	search			; search it
                            6B   D5  036B  1041 	tstl	(r11)			; Was it found?
                            21   12  036D  1042 	bneq	10$			; yes, exit with ( addr true ) on dstack
                   00001D35'EF   95  036F  1043 	tstb	v_mode			; no. Are we compiling?
                            19   13  0375  1044 	beql	10$			; no, exit leaving false on dstack
              6B   00001D27'EF   D0  0377  1045 	movl	v_compiler,(r11)	; yes, get address of compiler vocab
                   00000F83'EF   16  037E  1046 	jsb	search			; search it
                            6B   D5  0384  1047 	tstl	(r11)			; Was it found?
                            08   13  0386  1048 	beql	10$			; no, exit with false on dstack
           00001D34'EF   FF 8F   90  0388  1049 	movb	#c_true,v_state		; yes, set v_state flag
                                     0390  1050 					; exit with ( addr true ) on dstack
                                     0390  1051 10$:
                                 05  0390  1052 	rsb				; end of ?search
                                     0391  1053 ;??? Should the compiler vocabulary be searched *before* the context vocabulary
                                     0391  1054 ; when we are compiling?  This would allow defining new versions in compiler
