                                     1285  2615 ;	Searches string whose text is at `a2' and length is `n2' for substring
                                     1285  2616 ;	whose text is at `a1' and whose length is `n1'.  Returns true on top of
                                     1285  2617 ;	stack if found and under that ( a3 n3 ), address and length of located
                                     1285  2618 ;	substring.  Otherwise returns false.
                                     1285  2619 ;---
                                     1285  2620 	header	strpos
                         08 AB   39  1290  2621 	matchc	8(r11),-		; length of object string (to find)
                         0C BB       1293  2622 		@12(r11),-		; address of object string
                            6B       1295  2623 		(r11),-			; length of source string (to search in)
                         04 BB       1296  2624 		@4(r11)			; address of source string
                            19   12  1298  2625 	bneq	10$			; match not found
                    50   08 AB   D0  129A  2626 	movl	8(r11),r0		; save length of object string
                  51   53   50   C3  129E  2627 	subl3	r0,r3,r1		; calculate start addr of found string
                       5B   10   C0  12A2  2628 	addl2	#16,r11			; pop arguments
                       7B   51   D0  12A5  2629 	movl	r1,-(r11)		; put address of found string on stack
                       7B   50   D0  12A8  2630 	movl	r0,-(r11)		; put length of found string on stack
              7B   FFFFFFFF 8F   D0  12AB  2631 	movl	#c_true,-(r11)		; put true on stack
                                 05  12B2  2632 	rsb				; return
                                     12B3  2633 10$:
                       5B   10   C0  12B3  2634 	addl2	#16,r11			; pop arguments
                       7B   00   D0  12B6  2635 	movl	#c_false,-(r11)
                                 05  12B9  2636 	rsb				; end of strpos
