                                     12CF  2650 ;k> tochar -- convert top of stack from 0..9, A..Z to '0'..'9','A'..'Z'
                                     12CF  2651 ;	( n -- c ) where n is a number and c is a char.
                                     12CF  2652 ;	If not in range leave alone.
