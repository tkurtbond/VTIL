                                     151A  2874 ;*******************************************************************************
                                     151A  2875 ;
                                     151A  2876 ; Compiler Built-ins -- a new word is unlinked from the current vocabulary
                                     151A  2877 ;	and linked into the compiler vocabulary by the word { compiletime }.
                                     151A  2878 ;	Compiler (or compiletime) words are only searched for during the
                                     151A  2879 ;	definition of new words, which prevents them from mucking about with
                                     151A  2880 ;	the stacks and the dictionary when we are interpreting the user's
                                     151A  2881 ;	commands.
                                     151A  2882 ;
                                     151A  2883 ;*******************************************************************************
                                     151A  2884 compiler_begin:
                                     151A  2885 
                                     151A  2886 
                                     151A  2887 ;+++
                                     151A  2888 ;c> (variable) -- ( -- ) compiles the code body of a word that pushes the
                                     151A  2889 ;	address of its parameter field on the stack.  Must be the last word
                                     151A  2890 ;	in the word...
                                     151A  2891 ;---
                                     151A  2892 ;??? This concept is fuzzy.  Work on it.
                                     151A  2893      header	  i_variable,<(variable)>,vl_compiler
                    89   9E 8F   90  1529  2894      movb	  #op_movab,(r9)+	; `movab'
                    89   AF 8F   90  152D  2895      movb	  #adm_b_rel,(r9)+	; byte relative
                       89   02   90  1531  2896      movb	  #2,(r9)+		; (pc+2)
                    89   7B 8F   90  1534  2897      movb	  #adm_adec_r11,(r9)+	; -(r11)
                       89   05   90  1538  2898      movb	  #op_rsb,(r9)+		; `rsb'
                                 05  153B  2899      rsb				; end of (variable)
                                     153C  2900 
                                     153C  2901 
                                     153C  2902 ;+++
                                     153C  2903 ;c> +loop -- ( n -- ) where n is an increment.  Ends { do ... +loop }.  Adds top
                                     153C  2904 ;	of stack to loop index and branches to { do } if ((index >= 0) and
                                     153C  2905 ;	(index < limit)), or if ((index < 0) and (index > limit)).~~~ WTF: and should be or???
                                     153C  2906 ;	In other words, { +loop } with a positive argument is like Pascal's
                                     153C  2907 ;	{ for index := start to finish do ... } and with a negative argument
                                     153C  2908 ;	it is like { for index := start downto finish do }.
                                     153C  2909 ;---
                                     153C  2910 	header	i_plus_loop,<+loop>,vl_compiler
                    89   F1 8F   90  1546  2911 	movb	#op_acbl,(r9)+		; `acbl'
                    89   AA 8F   90  154A  2912 	movb	#adm_b_dis_r10,(r9)+	; b^(r10)
                       89   04   90  154E  2913 	movb	#4,(r9)+		; 4 byte displacement for previous adm
                    89   8B 8F   90  1551  2914 	movb	#adm_ainc_r11,(r9)+	; (r11)+
                    89   6A 8F   90  1555  2915 	movb	#adm_def_r10,(r9)+	; (r10)
                       50   59   D0  1559  2916 	movl	r9,r0			; save address of branch word
                       89   00   B0  155C  2917 	movw	#0,(r9)+		; save space for branch displacement
