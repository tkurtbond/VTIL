                           0000006A  0000   260 adm_def_r10	= ^x6a			; (r10)
                           0000007A  0000   261 adm_adec_r10	= ^x7a			; -(r10)
                           0000008A  0000   262 adm_ainc_r10	= ^x8a			; (r10)+
