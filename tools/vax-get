#!/bin/sh
# Copies files from the vtil account's home directory on the VAX by FTP,
# in active and ASCII mode, into the current directory, lowercased.
#
#   tools/vax-get <NAME.EXT>...
host=${VAX_HOST:-192.168.2.20}
netrc=${VAX_NETRC:-$HOME/.netrc-vtil-vax}
status=0
for f; do
  curl -s -S --netrc-file "$netrc" -P - --use-ascii \
    -o "$(echo "$f" | tr A-Z a-z)" "ftp://$host/$f" || status=1
done
exit $status
