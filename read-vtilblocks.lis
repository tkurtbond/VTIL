                           00000400  0000    12 c_block_size	= 1024			; size for block i/o buffer
                           00000004  0000    13 c_keysize	= 4			; size of key (longword record number)
                           00000002  0000    14 c_d_blks_in_blk = c_block_size / 512	; number of disk blocks in VTIL block
                                     0000    15 
                                 00000000    16 	.psect	readvbdata,long,noexe
                                     0000    17 ;
                                     0000    18 ; rms buffers for VTIL block i/o (which is actually rms record i/o)
                                     0000    19 ;
                                     0000    20 	.align long
                                     0000    21 v_blkfab:
                                     0000    22 	$fab	dnm=<vtilblocks.dat>,-	; default input file name
                                     0000    23 		fac=<get,put>,-		; block i/o operations
                                     0000    24 		fnm=<vtilblocks>,-	; input file name
                                     0000    25 		mrs=c_block_size,-	; maximum record size
                                     0000    26 		rfm=<fix>,-		; fixed length records
                                     0000    27 		org=<seq>		; Fun fact: you can do random access on
                                     0050    28 					;    sequential files, as long as 
                                     0050    29 					;    they're fixed record size!
                                     0050    30 
                                     0050    31 v_blkrab:
                                     0050    32 	$rab	fab=v_blkfab,-		; pointer to fab
                                     0050    33 		kbf=v_blkkey,-		; pointer to key
                                     0050    34 		ksz=c_keysize,-		; size of key
                                     0050    35 		rac=<key>,-		; random access by record number
                                     0050    36 		ubf=v_blkbuff,-		; address of user buffer
                                     0050    37 		usz=c_block_size	; and the record size
                                     0094    38 v_blkkey:
